\newlabel{tab:vars}{{1}{4}{Predictor variables by model. Three predictors (sentiment, waited, ln(followers)) are shared across both models; the remaining variables are specific to one}{table.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Descriptive statistics for outcomes and predictors. ``N (M1)'' is the sample for the revisit model (reviews with text); ``N (M2)'' is the sample for the rating model (reviews with text \emph  {and} a star rating).}}{4}{table.caption.2}\protected@file@percent }
\newlabel{tab:desc}{{2}{4}{Descriptive statistics for outcomes and predictors. ``N (M1)'' is the sample for the revisit model (reviews with text); ``N (M2)'' is the sample for the rating model (reviews with text \emph {and} a star rating)}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Pairwise correlations among the eight predictor variables (M2 sample, $N = 4{,}044$). All correlations are below 0.40 in absolute value except for ln(reviews) with ln(followers) ($r = 0.73$).}}{5}{table.caption.3}\protected@file@percent }
\newlabel{tab:corr}{{3}{5}{Pairwise correlations among the eight predictor variables (M2 sample, $N = 4{,}044$). All correlations are below 0.40 in absolute value except for ln(reviews) with ln(followers) ($r = 0.73$)}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Variance inflation factors (M2 sample). All VIFs are below 2.5, well under the common threshold of 5--10 for multicollinearity concern.}}{5}{table.caption.4}\protected@file@percent }
\newlabel{tab:vif}{{4}{5}{Variance inflation factors (M2 sample). All VIFs are below 2.5, well under the common threshold of 5--10 for multicollinearity concern}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Model fit summary. Pseudo-$R^2$ is McFadden's; AIC and BIC are Akaike and Bayesian information criteria (lower is better). AUC is the area under the ROC curve from cross-validation; within-$\pm 1$ accuracy is the proportion of M2 predictions within one category of the actual category.}}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:fit}{{5}{6}{Model fit summary. Pseudo-$R^2$ is McFadden's; AIC and BIC are Akaike and Bayesian information criteria (lower is better). AUC is the area under the ROC curve from cross-validation; within-$\pm 1$ accuracy is the proportion of M2 predictions within one category of the actual category}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Model 1: Binary logistic regression of Revisit. $N = 11{,}165$; pseudo-$R^2 = 0.201$; AIC $= 9{,}602$; BIC $= 9{,}858$. Place fixed effects included; standard errors clustered by reviewer.}}{6}{table.caption.6}\protected@file@percent }
\newlabel{tab:m1}{{6}{6}{Model 1: Binary logistic regression of Revisit. $N = 11{,}165$; pseudo-$R^2 = 0.201$; AIC $= 9{,}602$; BIC $= 9{,}858$. Place fixed effects included; standard errors clustered by reviewer}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Model 1 odds ratios with 95\% confidence intervals (log scale). Blue markers indicate $p < 0.05$. Dashed line at OR $= 1$ is the null-effect reference.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:forest_m1}{{1}{7}{Model 1 odds ratios with 95\% confidence intervals (log scale). Blue markers indicate $p < 0.05$. Dashed line at OR $= 1$ is the null-effect reference}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Model 1 confusion matrix at $p = 0.50$ threshold ($N = 11{,}165$).}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:cm1}{{7}{7}{Model 1 confusion matrix at $p = 0.50$ threshold ($N = 11{,}165$)}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Model 2: Multinomial logistic regression of Rating category. $N = 4{,}044$; pseudo-$R^2 = 0.190$; AIC $= 4{,}754$; BIC $= 5{,}157$. Odds ratios relative to the TOP (five-star) baseline. Place fixed effects included; SE clustered by reviewer.}}{8}{table.caption.9}\protected@file@percent }
\newlabel{tab:m2}{{8}{8}{Model 2: Multinomial logistic regression of Rating category. $N = 4{,}044$; pseudo-$R^2 = 0.190$; AIC $= 4{,}754$; BIC $= 5{,}157$. Odds ratios relative to the TOP (five-star) baseline. Place fixed effects included; SE clustered by reviewer}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Model 2 odds ratios with 95\% confidence intervals (log scale). Left panel: MID vs TOP. Right panel: LOW vs TOP. The asymmetric magnitudes across panels are the main empirical signature of the multinomial specification.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:forest_m2}{{2}{8}{Model 2 odds ratios with 95\% confidence intervals (log scale). Left panel: MID vs TOP. Right panel: LOW vs TOP. The asymmetric magnitudes across panels are the main empirical signature of the multinomial specification}{figure.caption.10}{}}
