    s.addText([
        { text: "Controls answer the obvious objection. ", options: { bold: true } },
        { text: "A longer review mentions more of everything, an older review has had more time to collect reactions, and a prolific reviewer behaves differently from a one-time visitor. Holding these fixed is what separates a cultural or behavioural effect from an artefact of who wrote the review and when.", options: {} }
    ], {
        x: MARGIN, y: 5.45, w: BODY_W, h: 1.2, isTextBox: true, margin: 0,
