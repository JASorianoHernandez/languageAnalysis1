{
    const s = contentSlide("5. Results", "Cross-cultural hypotheses", "문화 간 가설 검정");

    const rows = [[
        { text: "H", options: TABLE_HEAD },
        { text: "Dimension  문화 차원", options: TABLE_HEAD },
        { text: "Topic  주제", options: TABLE_HEAD },
        { text: "KO %", options: TABLE_HEAD },
        { text: "EN %", options: TABLE_HEAD },
        { text: "OR", options: TABLE_HEAD },
        { text: "p (Holm)", options: TABLE_HEAD },
        { text: "Robust", options: TABLE_HEAD }
    ]];
    hRows.forEach(r => {
        const supported = /Supported/i.test(r.result) && !/Not/i.test(r.result);
        const isRobust = /^y/i.test(r.robust);
        const strong = supported && isRobust;
        const o = strong ? { bold: true, color: THEME.colors.accent2 } : {};
        rows.push([
            { text: r.h, options: Object.assign({ bold: true }, strong ? { color: THEME.colors.accent2 } : {}) },
            { text: r.dimension, options: Object.assign({}, o) },
            { text: r.label, options: Object.assign({}, o) },
            { text: pct(r.koPct), options: Object.assign({ align: "right" }, o) },
            { text: pct(r.enPct), options: Object.assign({ align: "right" }, o) },
            { text: fmt(r.or), options: Object.assign({ align: "right" }, o) },
            { text: `${pval(r.p)} ${stars(r.p)}`.trim(), options: Object.assign({ align: "right" }, o) },
            { text: isRobust ? "yes" : "no", options: Object.assign({ align: "center" }, o) }
        ]);
    });
    s.addTable(rows, tableOpts({
        y: 1.3, colW: [0.55, 2.35, 2.5, 1.0, 1.0, 0.85, 1.55, 2.29], rowH: 0.42,
        fill: { color: "FFFFFF" }, fontSize: 11.5
    }));
    caption(s, `표 4. 출현 여부 기준 가설 검정 (카이제곱, Holm 보정; n = ${hTotalKo} KO / ${hTotalEn} EN).`,
        MARGIN, 4.05, BODY_W, "left");

    s.addShape(pres.ShapeType.roundRect, {
        x: MARGIN, y: 4.5, w: 6.0, h: 1.95, rectRadius: 0.06,
        fill: { color: THEME.colors.lt2 }, line: { color: THEME.colors.accent2, width: 1.5 },
        objectName: "h2-callout"
    });
    const h2 = hRows.find(r => r.h === "H2");
    s.addText([
        { text: "H2  Family & companions", options: { bold: true, color: THEME.colors.accent2, breakLine: true } },
        { text: h2 ? `Korean reviewers mention family and companions ${pct(h2.koPct)} of the time against ${pct(h2.enPct)} for foreign reviewers — an odds ratio of ${fmt(h2.or)}, p ${pval(h2.p)}.` : "—", options: { breakLine: true } },
        { text: "Significant in both the presence and the intensity test, and unchanged when ambiguous dictionary terms are dropped. This is the project's most robust finding.", options: { breakLine: true } },
        { text: "출현 여부와 강도 검정 모두에서 유의하며, 민감도 분석에서도 유지된다.", options: { fontSize: 11.5, color: "6E8288" } }
    ], {
        x: MARGIN + 0.22, y: 4.68, w: 5.56, h: 1.6, isTextBox: true, margin: 0,
        fontSize: 12, color: C.text1, lineSpacingMultiple: 1.06, paraSpaceAfter: 4
    });

    s.addText([
        { text: "Reading the rest", options: { bold: true, color: THEME.colors.accent1, breakLine: true } },
        { text: "H1 (planning) is significant in the raw test but does not survive the sensitivity run: the Korean word 시간 covers both 'opening hours' and 'a good time'.", options: { bullet: true, breakLine: true } },
        { text: "H3, H4 and H5 are not supported; H5 runs opposite to the prediction.", options: { bullet: true, breakLine: true } },
        { text: `Overall sentiment is close across groups (KO ${fmt(meanKo)} vs EN ${fmt(meanEn)}); the contrast is in subject matter, not satisfaction.`, options: { bullet: true } }
    ], {
        x: MARGIN + 6.35, y: 4.5, w: BODY_W - 6.35, h: 1.95, isTextBox: true, margin: 0,
        fontSize: 12, color: C.text1, lineSpacingMultiple: 1.06, paraSpaceAfter: 5,
        objectName: "other-h-note"
    });
    source(s, "Dictionaries behind H1-H5 were validated by manually coding keyword-in-context samples; terms below 70% precision are dropped in the sensitivity run.");
    s.addNotes("H2 is the headline. H1 is the cautionary tale: it shows why dictionary validation matters.");
}

{
