/*
 * Bilingual EN/KO proposal deck, built from the pipeline's result CSVs.
 *
 * Numbers are read from data/analysis/ at build time, so re-running this
 * script after a pipeline run refreshes the deck:
 *     node proposal/deck/build_deck.js
 *
 * Structure follows literature/IdeaTemplatepptx.pptx (Hoseo University):
 * title -> 목차 -> numbered section dividers -> content -> 감사합니다.
 */

const fs = require("fs");
const path = require("path");
const pptxgen = require("pptxgenjs");
// apply_theme.js resolves jszip relative to itself, so make this package's
// node_modules visible to it before requiring.
const SKILL_PPTX = path.join(
    process.env.USERPROFILE || process.env.HOME,
    ".claude/skills/synced/e0581bc6-3c76-46db-a07c-c4728ccb15d5_c2eab877-228e-40e7-8ef3-e87e2afc8873/pptx"
);
process.env.NODE_PATH = [path.join(__dirname, "node_modules"), process.env.NODE_PATH]
    .filter(Boolean).join(path.delimiter);
require("module").Module._initPaths();
const { applyTheme } = require(path.join(SKILL_PPTX, "scripts", "apply_theme.js"));

const ROOT = path.resolve(__dirname, "..", "..");
const ANALYSIS = path.join(ROOT, "data", "analysis");
const FIGURES = path.join(ANALYSIS, "figures");
const OUT = path.join(__dirname, "proposal_deck.pptx");

/* ------------------------------------------------------------------ *
 * CSV helpers
 * ------------------------------------------------------------------ */

function readCsv(file) {
    const full = path.isAbsolute(file) ? file : path.join(ANALYSIS, file);
    if (!fs.existsSync(full)) {
        console.warn(`  ! missing ${path.relative(ROOT, full)} - placeholders kept`);
        return [];
    }
    const text = fs.readFileSync(full, "utf8").replace(/^﻿/, "");
    const rows = [];
    let field = "", row = [], quoted = false;
    for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (quoted) {
            if (ch === '"') {
                if (text[i + 1] === '"') { field += '"'; i++; } else { quoted = false; }
            } else { field += ch; }
        } else if (ch === '"') { quoted = true; }
        else if (ch === ",") { row.push(field); field = ""; }
        else if (ch === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
        else if (ch !== "\r") { field += ch; }
    }
    if (field.length || row.length) { row.push(field); rows.push(row); }
    if (!rows.length) return [];
    const head = rows.shift().map(h => h.trim());
    return rows.filter(r => r.length === head.length)
               .map(r => Object.fromEntries(head.map((h, i) => [h, r[i]])));
}

/** Same as readCsv, but silent when the file is not there yet. */
function readCsvQuiet(file) {
    const full = path.isAbsolute(file) ? file : path.join(ANALYSIS, file);
    return fs.existsSync(full) ? readCsv(full) : [];
}

const num = v => { const n = parseFloat(v); return Number.isFinite(n) ? n : null; };
const fmt = (v, d = 2) => (v === null || v === undefined ? "—" : v.toFixed(d));
const pct = v => (v === null ? "—" : `${v.toFixed(1)}%`);

function pval(p) {
    if (p === null) return "—";
    if (p < 0.001) return "< 0.001";
    return p.toFixed(3);
}

function stars(p) {
    if (p === null) return "";
    if (p < 0.001) return "***";
    if (p < 0.01) return "**";
    if (p < 0.05) return "*";
    return "n.s.";
}

/* ------------------------------------------------------------------ *
 * Numbers pulled from the pipeline
 * ------------------------------------------------------------------ */

console.log("Reading results ...");

const hyp = readCsv("hypothesis_tests.csv");
const sens = readCsv("hypothesis_tests_sensitivity.csv");
const sim = readCsv("crosslingual_similarity.csv");
const sent = readCsv("summary_sentiment.csv");
const metrics = readCsvQuiet(path.join(ANALYSIS, "naver", "model_metrics_cv.csv"));
const kSel = readCsv("lda_k_selection.csv");

// corpus size from the sentiment summary
const corpusKo = sent.filter(r => r.language === "ko").reduce((a, r) => a + (num(r.count) || 0), 0);
const corpusEn = sent.filter(r => r.language === "en").reduce((a, r) => a + (num(r.count) || 0), 0);
const corpusPlaces = new Set(sent.map(r => r.place)).size;
const meanKo = sent.filter(r => r.language === "ko").reduce((a, r, _, A) => a + (num(r.mean) || 0) / A.length, 0);
const meanEn = sent.filter(r => r.language === "en").reduce((a, r, _, A) => a + (num(r.mean) || 0) / A.length, 0);

// cross-lingual similarity range
const simVals = sim.map(r => num(r.ko_en_sim)).filter(v => v !== null);
const simLo = simVals.length ? Math.min(...simVals) : null;
const simHi = simVals.length ? Math.max(...simVals) : null;

// hypothesis rows, in H order
const hRows = ["H1", "H2", "H3", "H4", "H5"].map(h => {
    const r = hyp.find(x => x.hypothesis === h);
    const s = sens.find(x => (x.hypothesis || x.H) === h);
    if (!r) return null;
    return {
        h,
        label: r.label,
        dimension: r.dimension,
        nKo: num(r.n_ko), nEn: num(r.n_en),
        koPct: num(r.ko_presence_pct), enPct: num(r.en_presence_pct),
        or: num(r.odds_ratio_ko_en),
        p: num(r.presence_p_holm),
        result: r.presence_result,
        robust: s ? (s.robust || s.Robust || "") : ""
    };
}).filter(Boolean);

const hTotalKo = hRows.length ? hRows[0].nKo : null;
const hTotalEn = hRows.length ? hRows[0].nEn : null;

// chosen K per language = highest mean coherence
function bestK(lang) {
    const rows = kSel.filter(r => r.language === lang);
    if (!rows.length) return null;
    return rows.reduce((b, r) => (num(r.coherence_mean) > num(b.coherence_mean) ? r : b)).k;
}
const kKo = bestK("ko"), kEn = bestK("en");

// model metrics
const metric = (model, name) => {
    const r = metrics.find(x => x.model === model && x.metric === name);
    return r ? num(r.value) : null;
};
const M = {
    m1Auc: metric("Model 1 revisit", "AUC"),
    m1xAuc: metric("Model 1x revisit, extended", "AUC"),
    m1Brier: metric("Model 1 revisit", "Brier"),
    m1Base: metric("Model 1 revisit", "Brier (base rate)"),
    m2Rmse: metric("Model 2 keyword tags", "RMSE ordered logit"),
    m2Base: metric("Model 2 keyword tags", "RMSE (predict mean)"),
    m2xRmse: metric("Model 2x keyword tags, extended", "RMSE ordered logit"),
    m4Auc: metric("Model 4b any reaction", "AUC"),
    m4Brier: metric("Model 4b any reaction", "Brier"),
    m4BrierBase: metric("Model 4b any reaction", "Brier (base rate)")
};

// Figures that will not change name between runs.
const FIG = {
    hypotheses: path.join(FIGURES, "13_hypothesis_tests.png"),
    kSelection: path.join(FIGURES, "14_lda_k_selection.png"),
    similarity: path.join(FIGURES, "08_crosslingual_sim.png"),
    sentiment: path.join(FIGURES, "01_sentiment_bar.png"),
    topicsKo: path.join(FIGURES, "04_topic_dist_ko.png"),
    geo: path.join(FIGURES, "11_geo_bubble_seoul.png")
};
const fig = k => (fs.existsSync(FIG[k]) ? FIG[k] : null);

/* Figures that still come from the older LLM run; flag them so the deck
 * never silently shows stale ABSA output as if it were current. */
const PENDING = "LLM steps (07) not yet re-run on this corpus";

console.log(`  corpus      ${corpusKo} KO + ${corpusEn} EN across ${corpusPlaces} places`);
console.log(`  hypotheses  ${hRows.length} rows, n = ${hTotalKo} KO / ${hTotalEn} EN`);
console.log(`  similarity  ${fmt(simLo)}-${fmt(simHi)}`);
console.log(`  LDA K       ko=${kKo} en=${kEn}`);
console.log(`  M1 AUC      ${fmt(M.m1Auc, 3)}`);

/* ------------------------------------------------------------------ *
 * Theme
 * ------------------------------------------------------------------ */

const THEME = {
    name: "Hoseo Reviews",
    headFontFace: "Malgun Gothic",
    bodyFontFace: "Malgun Gothic",
    colors: {
        dk1: "1A2B32",   // body text
        lt1: "FFFFFF",
        dk2: "2C4A54",   // divider / title backgrounds
        lt2: "F4F1EC",   // warm panel
        accent1: "55736D",  // sage  - domestic / Korean
        accent2: "C96F4A",  // terracotta - foreign / English
        accent3: "88A88E",
        accent4: "FFB09D",
        accent5: "44546A",
        accent6: "A8BFC4",
        hlink: "0563C1",
        folHlink: "954F72"
    }
};

const pres = new pptxgen();
pres.layout = "LAYOUT_WIDE";          // 13.333 x 7.5 in, matches the template
pres.theme = { headFontFace: THEME.headFontFace, bodyFontFace: THEME.bodyFontFace };
pres.author = "Jorge Adan Soriano Hernandez";
pres.title = "What Domestic and Foreign Tourists Write";
pres.subject = "Research proposal - cross-cultural analysis of Korean attraction reviews";

const C = pres.SchemeColor;
const W = 13.333, H = 7.5;
const MARGIN = 0.62;
const BODY_W = W - MARGIN * 2;

/* ------------------------------------------------------------------ *
 * Layouts
 * ------------------------------------------------------------------ */

pres.defineSlideMaster({
    title: "TITLE",
    background: { color: C.text2 },
    objects: [
        { rect: { x: 0, y: 0, w: 0.22, h: H, fill: { color: C.accent1 } } },
        { rect: { x: 0, y: H - 0.1, w: W, h: 0.1, fill: { color: C.accent2 } } },
        {
            placeholder: {
                options: {
                    name: "course", type: "body", x: 0.95, y: 0.85, w: 11.6, h: 0.35,
