{
    const s = contentSlide("4. Methodology", "Pipeline", "분석 파이프라인");
    const steps = [
        ["Place selection", "관광지 선정", "Yanolja Research Top 500 crossed with KTO visitor\nvolume, inside typological strata"],
        ["Collection", "수집", "Naver Place and Google Maps scrapers;\none common time window for both languages"],
        ["Preprocessing", "전처리", "Deduplication, language check, Korean and\nEnglish tokenisation"],
        ["Text analytics", "텍스트 분석", "Sentiment, LDA with K chosen by coherence and\nperplexity, aspect extraction"],
        ["Hypothesis tests", "가설 검정", "Hofstede H1-H5; Mann-Whitney U and chi-square,\nHolm-corrected, dictionaries validated"],
        ["Regression models", "회귀 모형", "Revisit, keyword diversity, reactions;\nplace fixed effects, clustered SE"]
    ];
    const cols = 3, cw = 3.95, ch = 2.1, gx = 0.37, gy = 0.42;
    steps.forEach(([en, ko, desc], i) => {
        const cx = MARGIN + (i % cols) * (cw + gx);
        const cy = 1.35 + Math.floor(i / cols) * (ch + gy);
        const accent = i < 3 ? THEME.colors.accent1 : THEME.colors.accent5;
        s.addShape(pres.ShapeType.roundRect, {
            x: cx, y: cy, w: cw, h: ch, rectRadius: 0.06,
            fill: { color: "FFFFFF" }, line: { color: "D8D2C9", width: 1 },
            objectName: `step-box-${i + 1}`
        });
        s.addShape(pres.ShapeType.rect, {
            x: cx, y: cy, w: cw, h: 0.07, fill: { color: accent }, objectName: `step-rule-${i + 1}`
        });
        s.addShape(pres.ShapeType.ellipse, {
            x: cx + 0.22, y: cy + 0.27, w: 0.46, h: 0.46,
            fill: { color: accent }, objectName: `step-dot-${i + 1}`
        });
        s.addText(String(i + 1), {
            x: cx + 0.22, y: cy + 0.3, w: 0.46, h: 0.4, isTextBox: true, margin: 0,
            fontSize: 15, bold: true, color: "FFFFFF", align: "center"
        });
        s.addText([
            { text: en, options: { bold: true, breakLine: true } },
            { text: ko, options: { fontSize: 11.5, color: "6E8288" } }
        ], {
            x: cx + 0.8, y: cy + 0.24, w: cw - 1.0, h: 0.62, isTextBox: true, margin: 0,
            fontSize: 14, color: THEME.colors.dk2
        });
        s.addText(desc, {
            x: cx + 0.22, y: cy + 0.95, w: cw - 0.44, h: 1.0, isTextBox: true, margin: 0,
            fontSize: 11.5, color: C.text1, lineSpacingMultiple: 1.05
        });
    });
    caption(s, "그림 1. 분석 파이프라인.", MARGIN, 6.35, BODY_W, "left");
    source(s, "Every step is scripted and re-runnable end to end (run_pipeline.py).");
}

