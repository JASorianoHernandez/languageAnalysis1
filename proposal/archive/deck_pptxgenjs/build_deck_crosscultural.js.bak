    }));
    caption(s, "표 5. 모형 성능 (작성자 단위 GroupKFold 교차검증).", MARGIN, 5.15, BODY_W, "left");

    s.addText([
        { text: "Cross-validation is grouped by reviewer", options: { bold: true } },
        { text: ", so no reviewer appears in both the training and the test fold. Every model is also re-estimated on one random review per reviewer and per place; the effects reported above are the ones that survive that check.", options: { breakLine: true } },
        { text: "교차검증은 작성자 단위로 분할하여, 동일 작성자가 학습과 검증에 함께 포함되지 않도록 하였다.", options: { fontSize: 11.5, color: "6E8288" } }
    ], {
        x: MARGIN, y: 5.6, w: BODY_W, h: 1.1, isTextBox: true, margin: 0,
        fontSize: 12.5, color: C.text1, lineSpacingMultiple: 1.06, paraSpaceAfter: 5,
        objectName: "cv-note"
    });
}

/* ------------------------------------------------------------------ *
 * 18-19. Conclusion
 * ------------------------------------------------------------------ */

pres.addSection({ title: "6. Conclusion" });
divider("6. Conclusion", 6, "Conclusion", "결론");

{
    const s = contentSlide("6. Conclusion", "Conclusion", "결론");
    const blocks = [
        ["What we find", "주요 결과", THEME.colors.accent1, [
            "The two groups rate Korean attractions almost identically, but write about different things: family and companions are the one dimension that separates them robustly.",
            "Among domestic reviewers, information diversity tracks engagement with the platform rather than the type of visit."
        ]],
        ["Limitations", "한계", THEME.colors.accent5, [
            "Platform and language are confounded: domestic reviews come from one platform and foreign ones from another, so a difference may reflect the platform as much as the culture.",
            "Results are associations; there is no time variation or natural experiment comparable to the keyword expansion Lee et al. (2026) exploit.",
            "English is a lingua franca, so the foreign group is culturally heterogeneous."
        ]],
        ["Next steps", "향후 계획", THEME.colors.accent2, [
            "Finish the LLM aspect extraction on the current corpus and validate it against blind manual coding (Cohen's kappa).",
            "Extend the paired corpus to the remaining attractions and report the window-length sensitivity.",
            "Test whether the family contrast holds inside place type, not only across places."
        ]]
    ];
    let y = 1.25;
    blocks.forEach(([en, ko, color, items], i) => {
        const h = 0.42 + items.length * 0.46;
        s.addShape(pres.ShapeType.rect, {
            x: MARGIN, y, w: 0.07, h, fill: { color }, objectName: `concl-rule-${i}`
        });
        s.addText([
            { text: en, options: { bold: true } },
            { text: `   ${ko}`, options: { bold: false, fontSize: 12, color: "6E8288" } }
        ], {
            x: MARGIN + 0.28, y, w: BODY_W - 0.28, h: 0.36, isTextBox: true, margin: 0,
            fontSize: 15, color
        });
        s.addText(items.map((t, j) => ({
            text: t, options: { bullet: true, breakLine: j < items.length - 1 }
        })), {
            x: MARGIN + 0.28, y: y + 0.38, w: BODY_W - 0.4, h: items.length * 0.46, isTextBox: true,
            margin: 0, fontSize: 12.5, color: C.text1, paraSpaceAfter: 4, lineSpacingMultiple: 1.05
        });
        y += h + 0.22;
    });
    source(s, `Work in progress: ${PENDING}.`);
}

/* ------------------------------------------------------------------ *
 * 20. Closing
 * ------------------------------------------------------------------ */

pres.addSection({ title: "Closing" });
{
    const s = pres.addSlide({ masterName: "CLOSING", sectionTitle: "Closing" });
    s.addText([
        { text: "Thank you", options: { bold: true, breakLine: true } },
        { text: "감사합니다", options: { fontSize: 30, color: "A8BFC4" } }
    ], {
        x: 1.0, y: 2.8, w: 11.3, h: 1.9, isTextBox: true, margin: 0,
        fontSize: 44, color: "FFFFFF", align: "center", objectName: "thanks"
    });
    s.addText("Jorge Adan Soriano Hernandez  ·  Department of Data Science, Hoseo University  ·  October 2026", {
        x: 1.0, y: 4.9, w: 11.3, h: 0.4, isTextBox: true, margin: 0,
        fontSize: 13, color: "7E9AA2", align: "center", objectName: "thanks-footer"
    });
}

/* ------------------------------------------------------------------ *
 * Write
 * ------------------------------------------------------------------ */

(async () => {
    await pres.writeFile({ fileName: OUT });
    await applyTheme(OUT, THEME);
    console.log(`\nWrote ${path.relative(ROOT, OUT)}`);
})().catch(err => { console.error(err); process.exit(1); });
