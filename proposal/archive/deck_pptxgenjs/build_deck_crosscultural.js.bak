    objects: [
        { rect: { x: 0, y: 0, w: 0.22, h: H, fill: { color: C.accent2 } } },
        {
            placeholder: {
                options: {
                    name: "title", type: "title", x: 1.4, y: 3.0, w: 10.6, h: 1.4,
