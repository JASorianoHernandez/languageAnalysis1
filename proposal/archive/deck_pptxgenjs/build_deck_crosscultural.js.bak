    });

    s.addShape(pres.ShapeType.roundRect, {
        x: MARGIN, y: 3.6, w: BODY_W, h: 2.55, rectRadius: 0.08,
        fill: { color: THEME.colors.lt2 }, line: { color: THEME.colors.accent2, width: 1.5 },
        objectName: "problem-box"
    });
    s.addText([
        { text: "Problem Statement", options: { bold: true } },
        { text: "   문제 정의", options: { bold: false, fontSize: 13, color: "6E8288" } }
    ], {
        x: MARGIN + 0.3, y: 3.8, w: BODY_W - 0.6, h: 0.36, isTextBox: true, margin: 0,
        fontSize: 16, color: THEME.colors.accent2
    });
    s.addText([
        { text: "Cross-cultural destination research has relied on surveys or on a single language. Chen et al. (2024) compared Chinese- and English-speaking tourists in Xiamen with LDA and BERT, without controlling for review length or repeat authorship. Lee et al. (2026) separated information ", options: {} },
        { text: "diversity", options: { bold: true } },
        { text: " from ", options: {} },
        { text: "quantity", options: { bold: true } },
        { text: ", yet their panel is aggregated by business and week, so individual review content stays invisible. Neither uses the visit metadata the platform already collects: companion, purpose, waiting time.", options: { breakLine: true } },
        { text: "기존 연구는 설문 또는 단일 언어 자료에 의존했고, 리뷰 길이와 반복 작성을 통제하지 않았으며, 자료가 업체·주 단위로 집계되어 개별 리뷰의 내용과 방문 맥락은 관측되지 않는다.", options: { fontSize: 12.5, color: "6E8288" } }
    ], {
        x: MARGIN + 0.3, y: 4.22, w: BODY_W - 0.6, h: 1.8, isTextBox: true, margin: 0,
        fontSize: 13.5, color: C.text1, lineSpacingMultiple: 1.08, paraSpaceAfter: 6
    });
}

