}

/* ------------------------------------------------------------------ *
 * 3-4. Introduction
 * ------------------------------------------------------------------ */

pres.addSection({ title: "1. Introduction" });
divider("1. Introduction", 1, "Introduction", "서론");

{
    const s = contentSlide("1. Introduction", "Introduction", "서론");
    s.addText([
        { text: "Online reviews are the main source travellers consult before choosing a destination.", options: { bullet: true, breakLine: true } },
        { text: "온라인 리뷰는 여행자가 목적지를 선택하기 전에 참고하는 핵심 정보원이다.", options: { bullet: true, color: "6E8288", fontSize: 13, breakLine: true } },
        { text: "In Korea the two audiences sit on two different platforms: domestic visitors review on Naver Place, foreign visitors on Google Maps.", options: { bullet: true, breakLine: true } },
        { text: "한국에서 두 집단은 서로 다른 플랫폼을 사용한다. 내국인은 네이버 플레이스, 외국인은 구글 지도에 리뷰를 남긴다.", options: { bullet: true, color: "6E8288", fontSize: 13, breakLine: true } },
        { text: "This study asks two questions about the same attractions: do the groups describe them differently, and what drives the information behaviour of the reviewers themselves?", options: { bullet: true, breakLine: true } },
        { text: "본 연구는 동일한 관광지를 대상으로 두 가지를 묻는다. 두 집단은 같은 장소를 다르게 서술하는가, 그리고 리뷰 작성자의 정보 행동은 무엇에 의해 결정되는가.", options: { bullet: true, color: "6E8288", fontSize: 13 } }
    ], {
        x: MARGIN, y: 1.25, w: BODY_W, h: 2.9, isTextBox: true, margin: 0,
        fontSize: 15, color: C.text1, paraSpaceAfter: 7, lineSpacingMultiple: 1.05,
        objectName: "intro-bullets"
    });

    const statW = 3.75, gap = 0.52;
    stat(s, MARGIN, 4.55, statW, "2", "Platforms compared", "비교 플랫폼", THEME.colors.accent5);
    stat(s, MARGIN + statW + gap, 4.55, statW, String(corpusPlaces || 12), "Attractions, paired corpus", "쌍 코퍼스 관광지", THEME.colors.accent1);
    stat(s, MARGIN + (statW + gap) * 2, 4.55, statW,
        (corpusKo + corpusEn).toLocaleString("en-US"), "Paired reviews, KO + EN", "쌍 리뷰 (한국어+영어)", THEME.colors.accent2);
}

/* ------------------------------------------------------------------ *
